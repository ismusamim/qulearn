# Pooled connection string — used by the app at runtime.
# Neon: the host ends in "-pooler". Local Docker: same as below.
DATABASE_URL="postgresql://qulearn:qulearn@127.0.0.1:55470/qulearn?schema=public"
# Direct connection string — used by Prisma Migrate (migrations can't run through a pooler).
DATABASE_URL_UNPOOLED="postgresql://qulearn:qulearn@127.0.0.1:55470/qulearn?schema=public"
